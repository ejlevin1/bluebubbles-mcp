# BlueBubbles server connection (required)
BLUEBUBBLES_URL=https://your-bluebubbles-server
BLUEBUBBLES_PASSWORD=your-server-password

# Force which send method sends use (optional).
#
# Normally unnecessary. By default (`auto`) sends use the BlueBubbles Private API when
# the server supports it (`private_api: true` and its helper connected), falling back to
# AppleScript otherwise — detected once at startup, not per call. Set `apple-script` or
# `private-api` to force one method regardless of what the server reports; an invalid
# value fails startup loudly rather than silently falling back to `auto`.
#
# Only sends follow this setting. Private-API *tools* (reactions, edits, unsends,
# typing indicators, read receipts) follow what the server reports, so forcing
# `private-api` against a server reporting `private_api: false` still removes them:
# that connection can send over the Private API but cannot express a threaded reply.
# BLUEBUBBLES_SEND_METHOD=auto

# Override the primary iMessage address for the local user (optional).
#
# Normally unnecessary. With the Private API enabled the server reports every
# address on the account via /icloud/account, and the one Apple currently sends
# from becomes the primary — so get_my_address is already correct without this.
# Set it only to force a different primary, or to name an address Apple does not
# report. It is additive: the discovered addresses are kept either way.
# BLUEBUBBLES_MY_ADDRESS=+15551234567

# Chat GUID that write-enabled integration tests may send into (optional).
#
# Leave unset and every write test skips — which is what happens in CI. Set it and
# `just test-integration` will send REAL messages into this chat. Without the Private
# API those messages cannot be unsent, so point this at a chat you own: texting your
# own number gives you a self-thread that is ideal for it.
#
# Quote the value — a chat GUID contains `;`, which POSIX shell sourcing splits on.
# TEST_WRITE_GUID='any;-;+15551234567'
